<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- requestNetwork() with a WifiNetworkSpecifier. No location permission:
       the system prompt is what the user consents to. -->
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <!-- The gauge's beacon (PodBeacon.kt): Android gives WiFi scan results
       only with location, and to a background check only with it "all the
       time". Asked for only when "Tell me about new drives" is switched on. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
