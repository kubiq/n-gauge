# arduino-cli build output (regenerable, ~60 MB)
build/
*.elf
*.map
*.merged.bin
*.partitions.bin
*.bootloader.bin

# Blender autosave backups
*.blend1

# Drive/sniffer logs pulled off the SD card - keep the ones you care about
# somewhere deliberate rather than letting every session accumulate here.
# GPX tracks are the worst offenders: at 25 Hz one drive is 5-17 MB.
# Use `git add -f` for a log that some finding actually rests on, as
# data/drive_0181.csv is.
log_*.csv
drive_*.csv
trip_*.gpx
sleeplog.txt

# Everything else dropped into data/ (pictures, scratch files) stays local
# too - the repo is public. Tracked files are not affected; add a new one
# with `git add -f`, deliberately.
data/*

# Pod STL exports: the published parts are tracked; new exports and
# work-in-progress stay local until added with `git add -f`.
mechanical/pod/*.stl

# CAD iterations: 43 .blend and 14 .stl at the repo root, ~200 MB of
# work-in-progress exports. The finished part gets committed deliberately -
# use `git add -f vent_final.stl` (or whatever you name it) when it's ready.
/vent*.blend
/vent*.stl
/vent?.blend1

# Full board flash snapshot (16 MB). Re-dumpable from the board with
# `esptool.py read_flash 0 0x1000000 <file>` if it's ever needed again.
firmware/backups/

# Vent reference photos (~10 MB). NOTE: these are not regenerable from
# anything in this repo - keep a copy somewhere outside it.
mechanical/reference/

# local build output from scripts/build.sh
.build/

__pycache__/

# Carrier manufacturing output - regenerate with hardware/carrier/export_fab.sh
hardware/carrier/fab/

# KiCad per-user and generated files (window layout, backups, caches)
*.kicad_prl
*-backups/
.history/
_restore_backup_*/
fp-info-cache
*.lck

# generated by scripts/build.sh on every build
firmware/car_gauge_v1/build_info.h

# Working notes - open work and measurements, kept local, not published.
TODO.md
